            ISVC["Services"]
            IREP["Repository<br/>IGenericRepository&lt;T&gt;"]
            ISEC["Security<br/>IJwtTokenGenerator, IGoogleTokenValidator, IPasswordHasher, IDataEncryptor"]
            IEML["Email<br/>IEmailService"]
            IXLS["Excel<br/>IExcelReader, ICsvReader, IExcelWriter, IPdfWriter"]
            ISTO["Storage<br/>IStorageService"]
        end
        SVC["Services<br/>34 application services"]
    end
    subgraph DOM["AdviseCare.Domain"]
        direction LR
        MOD["Models<br/>43 entity classes"]
        CTX["AdviseCareContext<br/>EF Core DbContext"]
    end
    subgraph INF["AdviseCare.Infrastructure"]
        direction LR
