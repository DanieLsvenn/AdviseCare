        direction LR
        REQ["Contracts.Requests"]
        RES["Contracts.Responses"]
        DTO["DTOs<br/>AccessDecision, AccessLogEntry, AttributeValue, ExcelRow, GoogleUserInfo, DataValueValidator"]
