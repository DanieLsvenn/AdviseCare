%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","textColor":"#000000","primaryColor":"#ffffff","primaryTextColor":"#000000","primaryBorderColor":"#000000","secondaryColor":"#ffffff","secondaryTextColor":"#000000","secondaryBorderColor":"#000000","tertiaryColor":"#ffffff","tertiaryTextColor":"#000000","tertiaryBorderColor":"#000000","lineColor":"#000000","mainBkg":"#ffffff","secondBkg":"#ffffff","nodeBorder":"#000000","clusterBkg":"#ffffff","clusterBorder":"#000000","defaultLinkColor":"#000000","actorBkg":"#ffffff","actorBorder":"#000000","actorTextColor":"#000000","actorLineColor":"#000000","signalColor":"#000000","signalTextColor":"#000000","labelBoxBkgColor":"#ffffff","labelBoxBorderColor":"#000000","labelTextColor":"#000000","noteBkgColor":"#ffffff","noteBorderColor":"#000000","noteTextColor":"#000000","activationBkgColor":"#ffffff","activationBorderColor":"#000000","sequenceNumberColor":"#000000","attributeBackgroundColor":"#ffffff","classBackground":"#ffffff","classBorder":"#000000"}}}%%
sequenceDiagram
    autonumber
    actor ADV as Advisor
    actor STU as Student
    participant W as Web App
    participant C as ConsentRequestsController
    participant S as ConsentRequestService
    participant N as INotificationService
    participant R as IGenericRepository
    participant DB as SQL Server
    ADV->>W: Ask the student for "Accommodation status" with a stated purpose
    W->>C: POST /api/ConsentRequests {studentId, consentPurposeId, dataAttributeId, purposeStated}
    C->>S: CreateAsync(CreatorId, request)
    S->>R: Check purpose covers the attribute, active policy for the advisor's role, no pending duplicate
    S->>R: CreateAsync(request, status = pending)
    R->>DB: INSERT CONSENTREQUESTS
    S->>N: NotifyAsync(student, "Consent request")
    STU->>W: Open received requests
    W->>C: GET /api/ConsentRequests/me/received
    alt student grants
        W->>C: PUT /api/ConsentRequests/{id}/grant
        C->>S: GrantAsync(StudentId, ConsentRequestId)
        S->>R: PrepareUpdate request (granted, respondedAt), PrepareCreate Consent and ConsentHistory
        S->>R: SaveAsync()
        R->>DB: UPDATE CONSENTREQUESTS, INSERT CONSENTS, CONSENTHISTORIES
    else student denies
        W->>C: PUT /api/ConsentRequests/{id}/deny
        C->>S: DenyAsync(StudentId, ConsentRequestId)
        S->>R: UpdateAsync(status = denied)
    end
    S->>N: NotifyAsync(advisor, answer)
    C-->>W: 200 OK
