    PROGRAMMES {
        uniqueidentifier programmeId PK "NOT NULL"
        uniqueidentifier facultyId FK "NOT NULL"
        nvarchar(255) programmeCode UK "NOT NULL"
        nvarchar(255) programmeName "NOT NULL"
        nvarchar(30) status "NOT NULL"
