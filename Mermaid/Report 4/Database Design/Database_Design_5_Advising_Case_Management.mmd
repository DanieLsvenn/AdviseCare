---
title: AdviseCare - Database Design - Advising / Case Management
---
erDiagram
    CASES {
        uniqueidentifier caseId PK "NOT NULL"
        uniqueidentifier advisorId FK "NULL"
        uniqueidentifier openedBy FK "NOT NULL"
        uniqueidentifier studentId FK "NOT NULL"
        uniqueidentifier subjectId FK "NULL"
        uniqueidentifier supportCategoryId FK "NOT NULL"
        nvarchar(max) requestReason "NOT NULL"
        datetime2(3) closedAt "NULL"
        datetime2(3) openedAt "NOT NULL"
        nvarchar(30) currentStage "NOT NULL"
        nvarchar(30) priority "NOT NULL"
        nvarchar(30) status "NOT NULL"
    }
    CASECHANGEREQUESTS {
        uniqueidentifier caseChangeRequestId PK "NOT NULL"
        uniqueidentifier caseId FK "NOT NULL"
        uniqueidentifier programmeHeadId FK "NULL"
        uniqueidentifier proposedAdvisorId FK "NOT NULL"
        uniqueidentifier requestedBy FK "NOT NULL"
        nvarchar(max) decisionNotes "NULL"
        nvarchar(max) reason "NOT NULL"
        datetime2(3) decidedAt "NULL"
        datetime2(3) requestedAt "NOT NULL"
        nvarchar(30) status "NOT NULL"
    }
    CASENOTES {
        uniqueidentifier caseNoteId PK "NOT NULL"
        uniqueidentifier authorId FK "NOT NULL"
        uniqueidentifier caseId FK "NOT NULL"
        nvarchar(max) noteText "NOT NULL"
        datetime2(3) createdAt "NOT NULL"
        datetime2(3) editedAt "NULL"
        bit isFinalized "NOT NULL"
    }
    CASESTAGEHISTORIES {
        uniqueidentifier caseStageHistoryId PK "NOT NULL"
        uniqueidentifier caseId FK "NOT NULL"
        uniqueidentifier changedBy FK "NOT NULL"
        nvarchar(max) reason "NOT NULL"
        datetime2(3) changedAt "NOT NULL"
        nvarchar(30) fromStage "NOT NULL"
        nvarchar(30) toStage "NOT NULL"
    }
    REFERRALS {
        uniqueidentifier referralId PK "NOT NULL"
        uniqueidentifier caseId FK "NOT NULL"
        uniqueidentifier fromAccountId FK "NOT NULL"
        uniqueidentifier toAccountId FK "NOT NULL"
        nvarchar(max) referralReason "NOT NULL"
        datetime2(3) acceptedAt "NULL"
        datetime2(3) createdAt "NOT NULL"
        nvarchar(30) priority "NOT NULL"
        nvarchar(30) status "NOT NULL"
    }
    CORRECTIONREQUESTS {
        uniqueidentifier correctionRequestId PK "NOT NULL"
        uniqueidentifier reviewedBy FK "NULL"
        uniqueidentifier studentDataId FK "NOT NULL"
        uniqueidentifier studentId FK "NOT NULL"
        varbinary(max) currentValue "NULL"
        nvarchar(max) decisionNotes "NULL"
        nvarchar(max) explanation "NOT NULL"
        varbinary(max) proposedValue "NULL"
        datetime2(3) decidedAt "NULL"
        datetime2(3) submittedAt "NOT NULL"
        nvarchar(30) status "NOT NULL"
    }
    ACCOUNTS {
        uniqueidentifier accountId PK "referenced table, see its own section"
    }
    STUDENTDATA {
        uniqueidentifier studentDataId PK "referenced table, see its own section"
    }
    SUBJECTS {
        uniqueidentifier subjectId PK "referenced table, see its own section"
    }
    SUPPORTCATEGORIES {
        uniqueidentifier supportCategoryId PK "referenced table, see its own section"
    }
    CASES ||--o{ REFERRALS : "caseId"
    ACCOUNTS ||--o{ REFERRALS : "fromAccountId"
