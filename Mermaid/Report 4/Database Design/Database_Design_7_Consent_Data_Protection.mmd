    CONSENTPURPOSES {
        uniqueidentifier consentPurposeId PK "NOT NULL"
        uniqueidentifier createdBy FK "NOT NULL"
        nvarchar(max) description "NULL"
        nvarchar(255) purposeName UK "NOT NULL"
        bit isForStatistics "NOT NULL"
        nvarchar(30) status "NOT NULL"
    }
    PURPOSE_ATTRIBUTE {
        uniqueidentifier consentPurposeId PK, FK "NOT NULL"
        uniqueidentifier dataAttributeId PK, FK "NOT NULL"
    }
    CONSENTS {
        uniqueidentifier consentId PK "NOT NULL"
        uniqueidentifier consentPurposeId FK "NOT NULL"
        uniqueidentifier dataAttributeId FK "NOT NULL"
        uniqueidentifier studentId FK "NOT NULL"
        datetime2(3) expiresAt "NULL"
        datetime2(3) grantedAt "NOT NULL"
        datetime2(3) withdrawnAt "NULL"
        nvarchar(30) status "NOT NULL"
    }
    CONSENTHISTORIES {
        uniqueidentifier consentHistoryId PK "NOT NULL"
        uniqueidentifier changedBy FK "NOT NULL"
        uniqueidentifier consentId FK "NOT NULL"
        datetime2(3) changedAt "NOT NULL"
        nvarchar(30) newStatus "NOT NULL"
        nvarchar(30) previousStatus "NULL"
    }
    CONSENTREQUESTS {
        uniqueidentifier consentRequestId PK "NOT NULL"
        uniqueidentifier advisorId FK "NOT NULL"
        uniqueidentifier consentPurposeId FK "NOT NULL"
        uniqueidentifier dataAttributeId FK "NOT NULL"
        uniqueidentifier studentId FK "NOT NULL"
        nvarchar(max) purposeStated "NOT NULL"
        datetime2(3) requestedAt "NOT NULL"
        datetime2(3) respondedAt "NULL"
        nvarchar(30) status "NOT NULL"
    }
    ACCESSPOLICIES {
        uniqueidentifier accessPolicyId PK "NOT NULL"
        uniqueidentifier consentPurposeId FK "NOT NULL"
        uniqueidentifier createdBy FK "NOT NULL"
        uniqueidentifier roleId FK "NOT NULL"
        nvarchar(30) status "NOT NULL"
    }
    ACCESSLOGS {
        uniqueidentifier accessLogId PK "NOT NULL"
        uniqueidentifier accessorId FK "NOT NULL"
        uniqueidentifier consentPurposeId FK "NULL"
        uniqueidentifier recordedUserId FK "NOT NULL"
        uniqueidentifier studentDataId FK "NULL"
        nvarchar(255) accessedResource "NOT NULL"
        datetime2(3) accessedAt "NOT NULL"
        bit isFlagged "NOT NULL"
        nvarchar(30) status "NULL"
    }
    EMERGENCYACCESSREQUESTS {
        uniqueidentifier emergencyAccessRequestId PK "NOT NULL"
        uniqueidentifier requestedBy FK "NOT NULL"
        uniqueidentifier stewardId FK "NULL"
        uniqueidentifier studentId FK "NOT NULL"
        nvarchar(max) justification "NOT NULL"
        nvarchar(max) rejectionReason "NULL"
        datetime2(3) requestedAt "NOT NULL"
        datetime2(3) decidedAt "NULL"
        datetime2(3) scopeExpiresAt "NULL"
        nvarchar(30) status "NOT NULL"
    }
    ERASUREREQUESTS {
        uniqueidentifier erasureRequestId PK "NOT NULL"
        uniqueidentifier attributeKeyId FK "NOT NULL"
        uniqueidentifier consentId FK "NOT NULL"
        uniqueidentifier executedBy FK "NULL"
        datetime2(3) executedAt "NULL"
        datetime2(3) requestedAt "NOT NULL"
        nvarchar(30) status "NOT NULL"
    }
    ATTRIBUTEKEYS {
        uniqueidentifier attributeKeyId PK "NOT NULL"
        uniqueidentifier dataAttributeId FK "NOT NULL"
        uniqueidentifier studentId FK "NOT NULL"
        nvarchar(255) wrappedKey "NULL"
        int masterKeyVersion "NOT NULL"
        datetime2(3) createdAt "NOT NULL"
        datetime2(3) destroyedAt "NULL"
        nvarchar(30) status "NOT NULL"
    }
